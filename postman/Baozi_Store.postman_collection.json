              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.unset(\"pedidoId\");",
              "pm.test(\"201 - Registro criado\", () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) {",
              "    const registro = pm.response.json();",
              "    pm.test(\"JSON do cenário e identificador gerado\", () => {",
              "        pm.expect(Number.isInteger(registro.id) && registro.id > 0).to.be.true;",
              "        pm.expect(registro.clienteId).to.eql(Number(pm.collectionVariables.get(\"clienteId\")));",
              "        pm.expect(registro.produtoId).to.eql(Number(pm.collectionVariables.get(\"produtoId\")));",
              "        pm.expect(registro.quantidade).to.eql(3);",
              "    });",
              "    pm.test(\"Location aponta para o registro criado\", () => {",
              "        pm.expect(pm.response.headers.get(\"Location\")).to.eql(pm.request.url.getPath() + \"/\" + registro.id);",
              "    });",
              "    pm.collectionVariables.set(\"pedidoId\", String(registro.id));",
              "}"
            ]
          }
        }
      ]
    },
