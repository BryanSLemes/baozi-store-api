{
  "info": {
    "name": "Baozi Store - UNINTER - Atividade Prática",
    "description": "Cenário acadêmico da Baozi Store. Execute de 01 a 12. Os POSTs capturam os IDs e os DELETEs excluem primeiro o pedido.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 - POST Cadastrar cliente",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/clientes",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "clientes"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Bryan Silva Lemes5262978\",\n  \"clienteDesde\": \"2026-11-09\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.unset(\"clienteId\");",
              "pm.test(\"201 - Registro criado\", () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) {",
              "    const registro = pm.response.json();",
              "    pm.test(\"JSON do cenário e identificador gerado\", () => {",
              "        pm.expect(Number.isInteger(registro.id) && registro.id > 0).to.be.true;",
              "        pm.expect(registro.nome).to.eql(\"Bryan Silva Lemes5262978\");",
              "        pm.expect(registro.clienteDesde).to.eql(\"2026-11-09\");",
              "    });",
              "    pm.test(\"Location aponta para o registro criado\", () => {",
              "        pm.expect(pm.response.headers.get(\"Location\")).to.eql(pm.request.url.getPath() + \"/\" + registro.id);",
              "    });",
              "    pm.collectionVariables.set(\"clienteId\", String(registro.id));",
              "}"
            ]
          }
        }
      ]
    },
