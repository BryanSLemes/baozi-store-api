              "pm.test(\"200 - Consulta bem-sucedida\", () => pm.response.to.have.status(200));",
              "pm.test(\"Resposta contém o registro criado neste cenário\", () => {",
              "    const id = Number(pm.collectionVariables.get(\"clienteId\"));",
              "    const registro = pm.response.json().find(item => item.id === id);",
              "    pm.expect(registro).to.be.an(\"object\");",
              "    pm.expect(registro.id).to.eql(id);",
              "    pm.expect(registro.nome).to.eql(\"Bryan Silva Lemes5262978\");",
              "    pm.expect(registro.clienteDesde).to.eql(\"2026-11-09\");",
